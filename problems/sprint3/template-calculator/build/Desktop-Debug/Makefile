sub-submission-distdir: FORCE
	@test -d submission/ || mkdir -p submission/
	cd submission/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/bikslou/ccp-Qt/cpp-gt-clean/problems/sprint3/template-calculator/submission/submission.pro -spec linux-g++ CONFIG+=debug CONFIG+=qml_debug ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/submission

sub-tests-distdir: FORCE
	@test -d tests/ || mkdir -p tests/
	cd tests/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/bikslou/ccp-Qt/cpp-gt-clean/problems/sprint3/template-calculator/tests/tests.pro -spec linux-g++ CONFIG+=debug CONFIG+=qml_debug ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/tests

